# =====================
# BASE DE DATOS ORACLE
# =====================
# Cadena de conexión completa, incluyendo usuario y contraseña
# Formato: Data Source=(...);User ID=USUARIO;Password=CONTRASEÑA;Pooling=true;...
DB_COEST=Data Source=(DESCRIPTION=(ADDRESS_LIST=(ADDRESS=(PROTOCOL=tcp)(HOST=scan-cludbadm3.policia.gov.co)(PORT=1538)))(CONNECT_DATA=(SERVER=dedicated)(SERVICE_NAME=TELEPOL_WLGENERAL)));User ID=USR_COEST;Password=

# =====================
# API EXTERNA PIP
# =====================
# Credenciales del usuario técnico para autenticación contra el servicio PIP
PIP_USUARIO=
PIP_CLAVE=

# =====================
# JWT
# =====================
# Clave secreta para firmar tokens. Mínimo 32 caracteres. Generar con:
#   openssl rand -base64 48
JWT_KEY=

# =====================
# CIFRADO AES (contraseñas SMTP)
# =====================
# Exactamente 32 caracteres (AES-256). Generar con:
#   openssl rand -base64 24 | tr -d '=' | cut -c1-32
CRYPTO_KEY=
